/-- Capella:452/480. After the constructed 33-chain, the eleventh
payload's first credited withdrawal is a constructed
`SweepWithdrawal` stamped at `start+33`. -/
def eleventhPayloadContinueSweep (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal (wstart + 33)
    sampleSweepCreds sampleSweepAmount

/-- Mutant: forget Capella:510 and restamp at the original start. -/
def eleventhPayloadContinueSweepRestart (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal wstart
    sampleSweepCreds sampleSweepAmount

/-- Mutant: stamp from Gloas:2016 first-payload visits=2. -/
def eleventhPayloadContinueSweepFromVisits (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal
    (wstart + (sweepVisit 15 14 firstPayloadSkipTakeBreakFlagged).1)
    sampleSweepCreds sampleSweepAmount

/-- Mutant: stamp from the 31-chain cursor `start+31`. -/
def eleventhPayloadContinueSweepFromThirtyOne (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal (wstart + 31)
    sampleSweepCreds sampleSweepAmount

/-- Mutant: freeze after the tenth payload's first continued sweep. -/
def eleventhPayloadContinueSweepFromThirtyTwo (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal (wstart + 32)
    sampleSweepCreds sampleSweepAmount

theorem eleventhPayloadContinueSweep_index (wstart : Nat) :
    (eleventhPayloadContinueSweep wstart).index = wstart + 33 :=
  rfl

theorem eleventhPayloadContinueSweep_ne_restart (wstart : Nat) :
    (eleventhPayloadContinueSweep wstart).index ≠
      (eleventhPayloadContinueSweepRestart wstart).index := by
  simp [eleventhPayloadContinueSweep, eleventhPayloadContinueSweepRestart,
    firstPayloadExitedSweepWithdrawal, mkSweepWithdrawal]

theorem eleventhPayloadContinueSweep_ne_visits (wstart : Nat) :
    (eleventhPayloadContinueSweep wstart).index ≠
      (eleventhPayloadContinueSweepFromVisits wstart).index := by
  simp [eleventhPayloadContinueSweep, eleventhPayloadContinueSweepFromVisits,
    firstPayloadExitedSweepWithdrawal, mkSweepWithdrawal,
    firstPayloadSkipTakeBreak_cap_visit]

theorem eleventhPayloadContinueSweep_ne_thirtyone (wstart : Nat) :
    (eleventhPayloadContinueSweep wstart).index ≠
      (eleventhPayloadContinueSweepFromThirtyOne wstart).index := by
