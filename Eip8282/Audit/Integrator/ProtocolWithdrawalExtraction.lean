        indexedWithdrawals (wstart + 15) (items b2)).drop
          (indexedWithdrawals wstart (items b1)).length =
        indexedWithdrawals (wstart + 15) (items b2) :=
    List.drop_left
  rw [hlen1] at hdrop
  rw [hdrop]
  exact second_payload_indexed_head wstart hreg₂ hfull₂ hprior₂ hval₂

