          indexedWithdrawals (wstart + 15) (items b2) ++
            indexedChain (wstart + 17) [b3]).drop 18 :=
    List.drop_drop
  have hdrop18 :
      (indexedWithdrawals wstart (items b1) ++
        indexedWithdrawals (wstart + 15) (items b2) ++
          indexedChain (wstart + 17) [b3]).drop 18 =
        (indexedChain (wstart + 17) [b3]).drop 1 := by
    rw [← hdd, hdrop]
  rw [hdrop18]
  have hchain : indexedChain (wstart + 17) [b3] =
