`SweepWithdrawal` stamped at `start+39`. -/
def fourteenthPayloadContinueSweep (wstart : Nat) : SweepWithdrawal :=
  firstPayloadExitedSweepWithdrawal (wstart + 39)
    sampleSweepCreds sampleSweepAmount

