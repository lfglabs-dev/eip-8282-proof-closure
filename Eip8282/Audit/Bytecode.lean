/-! ## Build-time gate: the byte literals decode the hex literals

Compiler-evaluated, not part of any proof term — no `native_decide` receipt and
no axiom. It exists so the `Array UInt8` literals above cannot drift from the
`*Hex` strings that `scripts/audit_metadata.py` diffs against `pinned/`. -/

#eval (do
  let checks : List (String × ByteArray × String) :=
    [ ("depositRuntime", depositRuntime, depositRuntimeHex)
    , ("depositInit", depositInit, depositInitHex)
    , ("exitRuntime", exitRuntime, exitRuntimeHex)
    , ("exitInit", exitInit, exitInitHex) ]
  for (name, bytes, hex) in checks do
    unless bytes.data == (fromHex hex).data do
      throw <| IO.userError s!"{name} byte literal does not decode {name}Hex"
  : IO Unit)

end Eip8282.Audit.Bytecode
