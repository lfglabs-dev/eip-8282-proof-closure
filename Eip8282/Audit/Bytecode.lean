namespace Eip8282.Audit.Bytecode

private def hexVal (c : Char) : Nat :=
  if 97 ≤ c.toNat then c.toNat - 87 else c.toNat - 48

private def fromHexGo (acc : Array UInt8) : List Char → Array UInt8
  | c1 :: c2 :: rest =>
      fromHexGo (acc.push ((hexVal c1 * 16 + hexVal c2).toUInt8)) rest
  | _ => acc

def fromHex (s : String) : ByteArray :=
  { data := fromHexGo #[] s.toList }

