  "findings": [
    {
      "id": "transaction_variants",
      "classification": "concrete mismatch",
      "finding": "Pinned Transaction has only types 0\u20133; Amsterdam accepts type 4, applies authorizations, resolves delegated code.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/State/Transaction.lean#L116",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/transactions.py#L411",
      "minimal_route": "Keep all admitted transaction types in a reference history relation. Prove authorization preprocessing preserves installed predeploy code/storage; model arbitrary delegated outer execution with an open-context frame adapter."
    },
    {
      "id": "admission",
      "classification": "missing adapter",
      "finding": "Pinned Upsilon accepts S_T and presupposes valid transactions; Amsterdam recovers sender, checks nonce, max gas fee plus value, and sender code.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/EVM/Semantics.lean#L830",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/fork.py#L543",
      "minimal_route": "Use reference admission plus explicit crypto/address assumptions, then map validated entry state. Do not derive funding or SYSTEM exclusion from arbitrary S_T."
    },
    {
      "id": "state_gas",
      "classification": "concrete mismatch",
      "finding": "Single pinned gas counter and SSTORE pricing differ from Amsterdam execution/state pools, spill, refill, and child merge.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/EVM/Gas.lean#L95",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/vm/gas.py#L423",
      "minimal_route": "Prove a two-pool potential with spill/refund liabilities. Relate installed runtime traces locally; separately budget arbitrary outer execution and all attempted append occurrences."
    },
    {
      "id": "new_opcodes",
      "classification": "concrete mismatch",
      "finding": "Amsterdam decodes CLZ 0x1e and SLOTNUM 0x4b; pinned EvmYul contains neither.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/EVM/Instr.lean",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/vm/instructions/__init__.py#L67",
      "minimal_route": "Do not simulate all outer bytecode with pinned evaluator. Prove framing, call-entry extraction, and resource conservation directly for reference outer steps, including these opcodes."
    },
    {
      "id": "collision",
      "classification": "concrete mismatch",
      "finding": "Pinned Lambda rejects nonempty storage as well as nonce/code. Amsterdam account_deployable tests only nonce/code.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/EVM/Semantics.lean#L615",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/state_tracker.py#L348",
      "minimal_route": "Installed nonempty runtime suffices to block creation at protected address in both. For arbitrary creation, retain reference behavior and prove frame/funding preservation; do not assert universal CREATE equivalence."
    },
    {
      "id": "code_immutability",
      "classification": "missing adapter with supporting rules",
      "finding": "Amsterdam authorization rejects nonempty nondelegation code; SELFDESTRUCT deletes only accounts created in this transaction. These support, but do not themselves prove, permanent installed code.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/Semantics.lean#L395",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/vm/eoa_delegation.py#L220",
      "minimal_route": "Induct from exact installation over every reference mutation and fork transition; show protected account never freshly created. Bind current_target/storage owner separately from code address."
    },
    {
      "id": "fuel",
      "classification": "missing adapter",
      "finding": "Nat interpreter fuel is distinct from EVM gas; OutOfFuel can propagate or be caught, and CREATE catches Lambda errors with an empty account map.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/EVM/Semantics.lean#L290",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/vm/interpreter.py",
      "minimal_route": "Construct sufficient fuel for extracted finite reference traces and prove stability; do not quantify arbitrary small fuel as real execution or use gas >= fuel."
    },
    {
      "id": "transfer_logs",
      "classification": "concrete mismatch",
      "finding": "Amsterdam emits EIP-7708 synthetic LOG3 transfer logs. These are not executed LOG0 opcodes or append events.",
      "pinned_source": "https://github.com/lfglabs-dev/EVMYulLean/blob/b62586650b4f96cc6da25f36574aaa8f329a6420/EvmYul/Semantics.lean#L395",
      "reference_source": "https://github.com/ethereum/execution-specs/blob/0cc100eb190b64b23baba72dac0165652eaec252/src/ethereum/forks/amsterdam/vm/__init__.py#L252",
      "minimal_route": "Use address/topics/length-filtered append occurrence projection; do not require raw full log-list equality."
    }
  ],
